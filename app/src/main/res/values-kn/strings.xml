    <!-- How SATARK works -->
    <string name="how_it_works_title">ಸತರ್ಕ್ ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ</string>
    <string name="step_input_title">1. ಇನ್‌ಪುಟ್</string>
    <string name="step_input_desc">ಅನುಮಾನಾಸ್ಪದ ಸಂದೇಶದ ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಹಂಚಿಕೊಳ್ಳಿ ಅಥವಾ ಪಠ್ಯವನ್ನು ಅಂಟಿಸಿ.</string>
    <string name="step_understand_title">2. ಅರ್ಥಮಾಡಿಕೊಳ್ಳಿ</string>
    <string name="step_understand_desc">ಆಪ್ಟಿಕಲ್ ಗುರುತಿಸುವಿಕೆ ಮೂಲಕ ಪ್ರಮುಖ ಹಕ್ಕುಗಳನ್ನು ಹೊರತೆಗೆಯಲಾಗುತ್ತದೆ.</string>
    <string name="step_verify_title">3. ಪರಿಶೀಲಿಸಿ</string>
    <string name="step_verify_desc">ನಿಯಂತ್ರಕ ದಾಖಲೆಗಳ ಆಧಾರದ ಮೇಲೆ ಭರವಸೆಗಳ ಸತ್ಯಾಸತ್ಯತೆಯನ್ನು ಪರೀಕ್ಷಿಸುತ್ತದೆ.</string>
    <string name="step_assess_title">4. ಮೌಲ್ಯಮಾಪನ</string>
    <string name="step_assess_desc">ವಂಚನೆಯ ಮಾದರಿಗಳು ಮತ್ತು ಒತ್ತಡದ ತಂತ್ರಗಳನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ.</string>
    <string name="step_protect_title">5. ರಕ್ಷಣೆ</string>
    <string name="step_protect_desc">ಕ್ರಮ ಕೈಗೊಳ್ಳುವ ಮುನ್ನ ಸುರಕ್ಷಿತ ಮತ್ತು ಸೂಕ್ತ ಮಾರ್ಗದರ್ಶನ ನೀಡುತ್ತದೆ.</string>

