    <string name="app_name">ಸತರ್ಕ್</string>
    <string name="app_tagline">ಯಾವುದೇ ಕ್ರಮ ಕೈಗೊಳ್ಳುವ ಮುನ್ನ ಅನುಮಾನಾಸ್ಪದ ಹಣಕಾಸು ಸಂದೇಶಗಳನ್ನು ಪರಿಶೀಲಿಸಿ.</string>
    <string name="app_subtitle">ಹೂಡಿಕೆದಾರರ ವಂಚನೆ ತಡೆ ಮತ್ತು ಆರ್ಥಿಕ ಸುರಕ್ಷತಾ ಸಹಾಯಕ</string>

