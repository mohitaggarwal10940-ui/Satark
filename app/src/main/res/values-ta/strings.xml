<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">சதர்க்</string>
    <string name="app_tagline">எந்த முடிவும் எடுக்கும் முன் சந்தேகத்திற்குரிய நிதி செய்திகளை சரிபார்க்கவும்.</string>
    <string name="app_subtitle">முதலீட்டாளர் மோசடி மற்றும் நிதி பாதுகாப்பு உதவியாளர்</string>

    <!-- Home Actions -->
    <string name="action_upload_screenshot">ஸ்கிரீன்ஷாட் பதிவேற்றுக</string>
    <string name="action_take_photo">புகைப்படம் எடுக்க</string>
    <string name="action_paste_text">உரையை ஒட்டுக</string>
    <string name="action_quick_tip">முதலீட்டு மோசடிகளிலிருந்து உங்கள் பணத்தை பாதுகாக்கவும்</string>

    <!-- How SATARK works -->
    <string name="how_it_works_title">சதர்க் எவ்வாறு செயல்படுகிறது</string>
    <string name="step_input_title">1. உள்ளீடு</string>
    <string name="step_input_desc">சந்தேகத்திற்குரிய செய்தியின் ஸ்கிரீன்ஷாட் பகிரவும் அல்லது உரையை ஒட்டவும்.</string>
    <string name="step_understand_title">2. புரிதல்</string>
    <string name="step_understand_desc">ஆப்டிகல் அடையாளம் மூலம் முக்கிய கோரிக்கைகள் பிரித்தெடுக்கப்படுகின்றன.</string>
    <string name="step_verify_title">3. சரிபார்ப்பு</string>
    <string name="step_verify_desc">ஒழுங்குமுறை பதிவுகள் அடிப்படையில் நம்பகத்தன்மை சரிபார்க்கப்படுகிறது.</string>
    <string name="step_assess_title">4. மதிப்பீடு</string>
    <string name="step_assess_desc">ஏமாற்று வடிவங்கள், அவசரப்படுத்தும் உத்திகள் மதிப்பீடு செய்யப்படுகின்றன.</string>
    <string name="step_protect_title">5. பாதுகாப்பு</string>
    <string name="step_protect_desc">முடிவெடுக்கும் முன் பாதுகாப்பான வழிகாட்டலை வழங்குகிறது.</string>

