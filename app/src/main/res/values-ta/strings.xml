    <string name="input_screen_title">சந்தேகத்திற்குரிய செய்தியை உள்ளிடவும்</string>
    <string name="input_screen_subtitle">மோசடி வடிவங்களை கண்டறிய எஸ்எம்எஸ், வாட்ஸ்அப் அல்லது டெலிகிராம் தகவல்களை ஒட்டவும்.</string>
    <string name="input_text_placeholder">இங்கு செய்தியை ஒட்டவும் (उदा. \"செபி பதிவு பெற்ற ஆலோசகர், 30% மாத லாபம் உத்தரவாதம்…\")</string>
    <string name="action_proceed_analysis">ஆய்வு செய்ய தொடரவும்</string>
    <string name="error_empty_input">பகுப்பாய்வு செய்ய உரையை உள்ளிடவும் அல்லது ஒட்டவும்.</string>

    <!-- Preview / Edit Screen -->
    <string name="preview_screen_title">பிரித்தெடுக்கப்பட்ட உள்ளடக்கத்தை சரிபார்க்கவும்</string>
    <string name="preview_subtitle">மதிப்பீட்டிற்கு அனுப்பும் முன் உரையை சரிபார்த்து திருத்தவும்.</string>
    <string name="preview_found_text">கண்டறியப்பட்ட உரை</string>
    <string name="preview_edit_hint">கீழே உள்ள உரையை நீங்கள் திருத்தலாம்</string>
    <string name="action_analyze_now">உள்ளடக்கத்தை பகுப்பாய்வு செய்க</string>
    <string name="action_retake">வேறு படம் தேர்ந்தெடுக்க</string>

