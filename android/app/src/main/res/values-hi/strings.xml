    <string name="app_name">सतर्क</string>
    <string name="app_tagline">संदिग्ध वित्तीय संदेशों की जांच करें, कोई भी कदम उठाने से पहले।</string>
    <string name="app_subtitle">निवेशक धोखाधड़ी एवं वित्तीय सुरक्षा सहायक</string>

    <!-- Home Actions -->
    <string name="action_upload_screenshot">स्क्रीनशॉट अपलोड करें</string>
    <string name="action_take_photo">फोटो लें</string>
    <string name="action_paste_text">टेक्स्ट पेस्ट करें</string>
    <string name="action_quick_tip">अपनी गाढ़ी कमाई को निवेश धोखाधड़ी से सुरक्षित रखें</string>

    <!-- How SATARK works -->
    <string name="how_it_works_title">सतर्क कैसे काम करता है</string>
    <string name="step_input_title">1. इनपुट</string>
    <string name="step_input_desc">स्क्रीनशॉट साझा करें या संदिग्ध निवेश सलाह पेस्ट करें।</string>
    <string name="step_understand_title">2. समझें</string>
    <string name="step_understand_desc">ऑप्टिकल पहचान के जरिए टेक्स्ट और मुख्य दावे निकाले जाते हैं।</string>
    <string name="step_verify_title">3. सत्यापित करें</string>
    <string name="step_verify_desc">नियामक संकेतों के आधार पर वादों की प्रामाणिकता जांची जाती है।</string>
    <string name="step_assess_title">4. आंकलन करें</string>
    <string name="step_assess_desc">भ्रामक पैटर्न, दबाव और जल्दबाजी के तौर-तरीकों का मूल्यांकन किया जाता है।</string>
    <string name="step_protect_title">5. सुरक्षित रहें</string>
    <string name="step_protect_desc">कदम उठाने से पहले आपको निष्पक्ष और सुरक्षित उपाय सुझाए जाते हैं।</string>

